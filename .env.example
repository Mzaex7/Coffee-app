# BrewRef environment — copy to `.env` and fill in. `.env` is gitignored.
#
# Supabase project values (Project Settings → API). The anon key is meant to be
# public; Row Level Security is what protects user data, so it is safe to ship
# in the client bundle.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NOTE: the Gemini API key is NO LONGER a client variable. It lives only as a
# Supabase Edge Function secret so it never ships to the browser/app:
#   supabase secrets set GEMINI_API_KEY=your-gemini-key
